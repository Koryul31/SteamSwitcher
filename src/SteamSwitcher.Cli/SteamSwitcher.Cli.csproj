<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\SteamSwitcher.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <AssemblyName>SteamSwitcher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamSwitcher.Core\SteamSwitcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\backend\SteamSwitcher.ico" Link="Assets\SteamSwitcher.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
