<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#151612</Color>
    <Color x:Key="TitleBarColor">#191B16</Color>
    <Color x:Key="DockColor">#191B16</Color>
    <Color x:Key="SurfaceColor">#1E201A</Color>
    <Color x:Key="SurfaceAltColor">#292B23</Color>
    <Color x:Key="FieldColor">#1A1C17</Color>
    <Color x:Key="InkColor">#F2EEE4</Color>
    <Color x:Key="MutedColor">#A7A193</Color>
    <Color x:Key="BorderColor">#35372D</Color>
    <Color x:Key="AccentColor">#9BCBB1</Color>
    <Color x:Key="AccentSoftColor">#263A30</Color>
    <Color x:Key="BayBAccentColor">#86A9FF</Color>
    <Color x:Key="BayBAccentSoftColor">#24324B</Color>
    <Color x:Key="OnAccentColor">#102018</Color>
    <Color x:Key="WarningColor">#D99768</Color>
    <Color x:Key="WarningSoftColor">#392A20</Color>
    <Color x:Key="DangerColor">#E58A7B</Color>
    <Color x:Key="GridLineColor">#0EF2EEE4</Color>
    <Color x:Key="HoverColor">#252820</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />
    <SolidColorBrush x:Key="DockBrush" Color="{StaticResource DockColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="BayBAccentBrush" Color="{StaticResource BayBAccentColor}" />
    <SolidColorBrush x:Key="BayBAccentSoftBrush" Color="{StaticResource BayBAccentSoftColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />

    <DrawingBrush x:Key="PageGridBrush" TileMode="Tile"
                  Viewport="0,0,32,32" ViewportUnits="Absolute"
                  Stretch="None" AlignmentX="Left" AlignmentY="Top">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="Transparent">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="16,0" EndPoint="16,32" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="{StaticResource GridLineBrush}" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
