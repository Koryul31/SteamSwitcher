<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:SteamSwitcher.Setup.Converters">

    <FontFamily x:Key="DisplayFont">pack://application:,,,/SteamSwitcher.Setup;component/Assets/Fonts/#Instrument Serif</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/SteamSwitcher.Setup;component/Assets/Fonts/#Instrument Sans</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/SteamSwitcher.Setup;component/Assets/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

