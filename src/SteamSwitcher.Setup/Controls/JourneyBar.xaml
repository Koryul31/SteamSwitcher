<UserControl x:Class="SteamSwitcher.Setup.Controls.JourneyBar"
             xmlns:loc="clr-namespace:SteamSwitcher.Setup.Localization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="78"
             AutomationProperties.Name="Journey">
    <UserControl.Resources>
        <Style x:Key="JourneyStepButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5,6,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StepSurface" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StepSurface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="StepSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Border x:Name="BaseLine" Height="1" Background="{DynamicResource BorderBrush}"
                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,15,0,0" Width="0" />
        <Border x:Name="ProgressLine" Height="1" Background="{DynamicResource AccentBrush}"
                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,15,0,0" Width="0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="Step0" Grid.Column="0" Style="{StaticResource JourneyStepButton}" Tag="0" Click="Step_Click" AutomationProperties.Name="{loc:Loc Key=StepInstallations}" AutomationProperties.AutomationId="JourneyStepInstallations">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Width="20" Height="20" HorizontalAlignment="Left">
                        <Border x:Name="Halo0" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Opacity="0" />
                        <Border x:Name="Marker0" Width="12" Height="12" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource DockBrush}" />
                    </Grid>
                    <TextBlock x:Name="Label0" Grid.Row="1" Text="{loc:Loc Key=StepInstallations}" FontFamily="{StaticResource BodyFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="State0" Grid.Row="2" Text="{loc:Loc Key=StatePending}" FontFamily="{StaticResource BodyFont}"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                </Grid>
            </Button>

            <Button x:Name="Step1" Grid.Column="1" Style="{StaticResource JourneyStepButton}" Tag="1" Click="Step_Click" AutomationProperties.Name="{loc:Loc Key=StepAccounts}" AutomationProperties.AutomationId="JourneyStepAccounts">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Width="20" Height="20" HorizontalAlignment="Left">
                        <Border x:Name="Halo1" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Opacity="0" />
                        <Border x:Name="Marker1" Width="12" Height="12" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource DockBrush}" />
                    </Grid>
                    <TextBlock x:Name="Label1" Grid.Row="1" Text="{loc:Loc Key=StepAccounts}" FontFamily="{StaticResource BodyFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="State1" Grid.Row="2" Text="{loc:Loc Key=StatePending}" FontFamily="{StaticResource BodyFont}"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                </Grid>
            </Button>

            <Button x:Name="Step2" Grid.Column="2" Style="{StaticResource JourneyStepButton}" Tag="2" Click="Step_Click" AutomationProperties.Name="{loc:Loc Key=StepAccess}" AutomationProperties.AutomationId="JourneyStepShortcuts">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Width="20" Height="20" HorizontalAlignment="Left">
                        <Border x:Name="Halo2" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Opacity="0" />
                        <Border x:Name="Marker2" Width="12" Height="12" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource DockBrush}" />
                    </Grid>
                    <TextBlock x:Name="Label2" Grid.Row="1" Text="{loc:Loc Key=StepAccess}" FontFamily="{StaticResource BodyFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="State2" Grid.Row="2" Text="{loc:Loc Key=StatePending}" FontFamily="{StaticResource BodyFont}"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                </Grid>
            </Button>

            <Button x:Name="Step3" Grid.Column="3" Style="{StaticResource JourneyStepButton}" Tag="3" Click="Step_Click" AutomationProperties.Name="{loc:Loc Key=StepSummary}" AutomationProperties.AutomationId="JourneyStepSummary">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Width="20" Height="20" HorizontalAlignment="Left">
                        <Border x:Name="Halo3" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Opacity="0" />
                        <Border x:Name="Marker3" Width="12" Height="12" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource DockBrush}" />
                    </Grid>
                    <TextBlock x:Name="Label3" Grid.Row="1" Text="{loc:Loc Key=StepSummary}" FontFamily="{StaticResource BodyFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="State3" Grid.Row="2" Text="{loc:Loc Key=StateReview}" FontFamily="{StaticResource BodyFont}"
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                </Grid>
            </Button>
        </Grid>

        <Border x:Name="SelectionBar" Height="3" CornerRadius="1.5"
                Background="{DynamicResource AccentBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="8,0,0,0" Width="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SelectionBarTranslate" X="0" />
            </Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>

