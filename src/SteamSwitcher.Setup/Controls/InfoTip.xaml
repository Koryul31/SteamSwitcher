<UserControl x:Class="SteamSwitcher.Setup.Controls.InfoTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource HelpStrip}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="22" Height="22" CornerRadius="11"
                    Background="{DynamicResource AccentSoftBrush}"
                    VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="i" FontFamily="{StaticResource BodyFont}" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=Root}"
                       Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            <ContentPresenter Grid.Column="2" Content="{Binding Actions, ElementName=Root}"
                              VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>
    </Border>
</UserControl>
