<UserControl x:Class="SteamSwitcher.Setup.Views.InstallWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SteamSwitcher.Setup.Localization"
             x:Name="InstallWizardRoot"
             Background="{DynamicResource WindowBackgroundBrush}"
             Focusable="True"
             Loaded="Wizard_Loaded"
             Unloaded="Wizard_Unloaded">

    <UserControl.Resources>
        <Style x:Key="WizardTitle" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
            <Setter Property="FontSize" Value="44" />
            <Setter Property="LineHeight" Value="46" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="300" />
        </Style>

        <Style x:Key="WizardSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="LineHeight" Value="32" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="WizardSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,18" />
        </Style>

        <Style x:Key="WizardTargetCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="WizardStatusBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WizardStageLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>

        <Style x:Key="WizardStageDestinations" TargetType="TextBlock" BasedOn="{StaticResource WizardStageLabel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDestinations}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WizardStageProgress" TargetType="TextBlock" BasedOn="{StaticResource WizardStageLabel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProgress}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WizardStageDone" TargetType="TextBlock" BasedOn="{StaticResource WizardStageLabel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WizardProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4" />
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="34,18,34,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Key=InstallWizardKicker}" Style="{StaticResource KickerText}"
                           VerticalAlignment="Center" />
                <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}"
                        Margin="12,0" VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding StepLabel}" Style="{StaticResource MonoText}"
                           FontSize="10.5" VerticalAlignment="Center"
                           FlowDirection="LeftToRight" />
            </StackPanel>

            <Button x:Name="CloseButton" Style="{StaticResource GhostButton}"
                    Content="{Binding CloseLabel}" Padding="11,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    IsEnabled="{Binding CanCancel}"
                    AutomationProperties.AutomationId="InstallWizardCloseButton"
                    Command="{Binding CancelCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
            <Grid Margin="34,10,34,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,26,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=InstallWizardTitle}"
                               Style="{StaticResource WizardTitle}" />
                    <TextBlock Text="{loc:Loc Key=InstallWizardSubtitle}"
                               Style="{StaticResource PageSubtitle}"
                               Margin="0,15,0,0"
                               MaxWidth="290" />

                    <StackPanel Margin="0,26,0,0">
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="01" Style="{StaticResource MonoText}" FontSize="10.5"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc Key=InstallWizardStageDestinations}"
                                       Style="{StaticResource WizardStageDestinations}" />
                        </Grid>
                        <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}"
                                HorizontalAlignment="Left" Margin="4,0,0,0" />
                        <Grid Margin="0,13,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="02" Style="{StaticResource MonoText}" FontSize="10.5"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc Key=InstallWizardStageInstall}"
                                       Style="{StaticResource WizardStageProgress}" />
                        </Grid>
                        <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}"
                                HorizontalAlignment="Left" Margin="4,0,0,0" />
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="03" Style="{StaticResource MonoText}" FontSize="10.5"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc Key=StateReady}"
                                       Style="{StaticResource WizardStageDone}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Border x:Name="DestinationsPanel" Style="{StaticResource WizardSurface}"
                            Visibility="{Binding IsDestinations, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=InstallWizardDestinationsTitle}"
                                       Style="{StaticResource WizardSectionTitle}" FontSize="28" LineHeight="30" />
                            <TextBlock Text="{loc:Loc Key=InstallWizardDestinationsDesc}"
                                       Style="{StaticResource CaptionText}" Margin="0,7,0,0" />
                            <TextBlock Text="{loc:Loc Key=PathNamingHint}"
                                       Style="{StaticResource CaptionText}" Margin="0,5,0,0" />

                            <Border Style="{StaticResource WizardTargetCard}" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="A" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Steam A" Style="{StaticResource SectionTitle}" FontSize="13" />
                                        <TextBlock Text="{Binding SpaceA}" Style="{StaticResource CaptionText}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource WizardStatusBadge}">
                                        <TextBlock Text="{Binding StatusA}" Style="{StaticResource CaptionText}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding PathA, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FieldTextBox}"
                                                 IsEnabled="{Binding CanEditA}"
                                                 FlowDirection="LeftToRight"
                                                 AutomationProperties.AutomationId="InstallWizardPathA" />
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                                Content="{loc:Loc Key=ChooseFolder}"
                                                Padding="12,0" Margin="8,0,0,0"
                                                IsEnabled="{Binding CanEditA}"
                                                Command="{Binding ChooseACommand}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource WizardTargetCard}" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8"
                                            Background="{DynamicResource BayBAccentSoftBrush}">
                                        <TextBlock Text="B" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Foreground="{DynamicResource BayBAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Steam B" Style="{StaticResource SectionTitle}" FontSize="13" />
                                        <TextBlock Text="{Binding SpaceB}" Style="{StaticResource CaptionText}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource WizardStatusBadge}">
                                        <TextBlock Text="{Binding StatusB}" Style="{StaticResource CaptionText}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding PathB, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FieldTextBox}"
                                                 IsEnabled="{Binding CanEditB}"
                                                 FlowDirection="LeftToRight"
                                                 AutomationProperties.AutomationId="InstallWizardPathB" />
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                                Content="{loc:Loc Key=ChooseFolder}"
                                                Padding="12,0" Margin="8,0,0,0"
                                                IsEnabled="{Binding CanEditB}"
                                                Command="{Binding ChooseBCommand}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8"
                                    Padding="12,10" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=InstallWizardUacNote}"
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{loc:Loc Key=InstallWizardOfficial}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding ErrorText}"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ProgressPanel" Style="{StaticResource WizardSurface}"
                            Visibility="{Binding IsProgress, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=InstallWizardProgressTitle}"
                                       Style="{StaticResource WizardSectionTitle}" FontSize="30" LineHeight="32" />
                            <TextBlock Text="{loc:Loc Key=InstallWizardProgressDesc}"
                                       Style="{StaticResource CaptionText}" Margin="0,8,0,0" />

                            <Grid Margin="0,24,0,0">
                                <ProgressBar Style="{StaticResource WizardProgressBar}"
                                             Value="{Binding ProgressValue, Mode=OneWay}"
                                             Maximum="100" />
                                <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                                           Style="{StaticResource MonoText}" FontSize="10.5"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,4,-18" />
                            </Grid>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource BodyText}" FontSize="13"
                                       Margin="0,18,0,0" TextWrapping="Wrap" />

                            <StackPanel Margin="0,18,0,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="7"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="A" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Steam A" Style="{StaticResource SectionTitle}"
                                               FontSize="12.5" VerticalAlignment="Center" Margin="9,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusA}"
                                               Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="7"
                                            Background="{DynamicResource BayBAccentSoftBrush}">
                                        <TextBlock Text="B" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Foreground="{DynamicResource BayBAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Steam B" Style="{StaticResource SectionTitle}"
                                               FontSize="12.5" VerticalAlignment="Center" Margin="9,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusB}"
                                               Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8"
                                    Padding="12,10" Margin="0,20,0,0"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ErrorText}"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="{loc:Loc Key=InstallWizardRetry}"
                                    HorizontalAlignment="Left" Padding="13,0"
                                    Margin="0,12,0,0"
                                    Command="{Binding RetryCommand}"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="DonePanel" Style="{StaticResource WizardSurface}"
                            Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="24"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Left">
                                <Viewbox Width="24" Height="24"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M3,12 L9,18 L21,4"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Border>
                            <TextBlock Text="{loc:Loc Key=InstallWizardDoneTitle}"
                                       Style="{StaticResource WizardSectionTitle}" FontSize="32" LineHeight="34"
                                       Margin="0,18,0,0" />
                            <TextBlock Text="{loc:Loc Key=InstallWizardDoneDesc}"
                                       Style="{StaticResource BodyText}" Margin="0,8,0,0" />

                            <Border Style="{StaticResource WizardTargetCard}" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Steam A" Style="{StaticResource SectionTitle}" FontSize="12.5" />
                                    <TextBlock Text="{Binding PathA}" Style="{StaticResource MonoText}"
                                               FlowDirection="LeftToRight" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Steam B" Style="{StaticResource SectionTitle}" FontSize="12.5"
                                               Margin="0,14,0,0" />
                                    <TextBlock Text="{Binding PathB}" Style="{StaticResource MonoText}"
                                               FlowDirection="LeftToRight" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:Loc Key=InstallWizardOfficial}"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="34,0,34,18">
            <Grid x:Name="DestinationsFooter"
                  Visibility="{Binding IsDestinations, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:Loc Key=InstallWizardOfficial}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Key=ActionCancel}"
                            Padding="13,0" Command="{Binding CancelCommand}" />
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="{loc:Loc Key=InstallWizardStart}"
                            Padding="18,0" Margin="6,0,0,0"
                            IsEnabled="{Binding CanStart}"
                            AutomationProperties.AutomationId="InstallWizardStartButton"
                            Command="{Binding StartCommand}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ProgressFooter"
                  Visibility="{Binding IsProgress, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:Loc Key=InstallWizardUacNote}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           MaxWidth="560" TextTrimming="CharacterEllipsis" />
                <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Key=ActionCancel}"
                        Padding="13,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsEnabled="{Binding CanCancel}" Command="{Binding CancelCommand}" />
            </Grid>

            <Grid x:Name="DoneFooter"
                  Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:Loc Key=InstallWizardDoneDesc}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           MaxWidth="520" TextTrimming="CharacterEllipsis" />
                <Button x:Name="FinishButton" Style="{StaticResource PrimaryButton}" Content="{Binding DoneActionLabel}"
                        Padding="18,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="InstallWizardFinishButton"
                        Command="{Binding FinishCommand}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
