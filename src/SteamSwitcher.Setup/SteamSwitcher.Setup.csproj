<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\SteamSwitcher.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyTitle>SteamSwitcher Manager</AssemblyTitle>
    <Product>SteamSwitcher</Product>
    <Company>SteamSwitcher Contributors</Company>
    <Authors>SteamSwitcher Contributors</Authors>
    <Copyright>Copyright © 2026</Copyright>
    <Description>Modern, fast account and multi-installation manager for Steam.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamSwitcher.Core\SteamSwitcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SteamSwitcher.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
