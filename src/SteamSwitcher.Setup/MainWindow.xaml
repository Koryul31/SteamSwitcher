<Window x:Class="SteamSwitcher.Setup.MainWindow"
             xmlns:loc="clr-namespace:SteamSwitcher.Setup.Localization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteamSwitcher.Setup.Controls"
        Title="SteamSwitcher Setup"
        Width="1000" Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="152" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22" Stretch="Uniform">
                        <Canvas Width="144" Height="108">
                            <!-- active track: knob on the right -->
                            <Border Canvas.Left="0" Canvas.Top="0" Width="144" Height="48" CornerRadius="24"
                                    Background="{DynamicResource AccentBrush}" />
                            <Ellipse Canvas.Left="103" Canvas.Top="7" Width="34" Height="34"
                                     Fill="{DynamicResource TitleBarBrush}" />
                            <!-- inactive track: knob on the left -->
                            <Border Canvas.Left="0" Canvas.Top="60" Width="144" Height="48" CornerRadius="24"
                                    Background="{DynamicResource AccentSoftBrush}" />
                            <Ellipse Canvas.Left="7" Canvas.Top="67" Width="34" Height="34"
                                     Fill="{DynamicResource AccentBrush}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="SteamSwitcher" FontFamily="{StaticResource BodyFont}" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Path Style="{StaticResource SteamGlyphStyle}" Width="14" Height="14" Margin="9,0,0,0"
                          Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc Key=AppConfig}" FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OptionsButton" Style="{StaticResource WindowButton}" Click="OptionsButton_Click"
                            Margin="0,0,4,0"
                            ToolTip="{loc:Loc Key=StepOptions}"
                            AutomationProperties.Name="{loc:Loc Key=StepOptions}"
                            AutomationProperties.AutomationId="OptionsGearButton">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="MinimizeButton_Click"
                            AutomationProperties.Name="{loc:Loc Key=Minimize}">
                        <TextBlock Text="—" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="CloseButton_Click"
                            AutomationProperties.Name="{loc:Loc Key=CloseWindow}" Margin="4,0,0,0">
                        <TextBlock Text="×" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="SetupContentGrid" Grid.Row="1" Background="{DynamicResource PageGridBrush}" ClipToBounds="True">
            <Grid Margin="34,22,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,34,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="StepKickerText" Text="{loc:Loc Key=PageInstallKicker}"
                                   Style="{StaticResource KickerText}" />
                        <TextBlock x:Name="PageTitleText" Text="{loc:Loc Key=StepInstallations}" Style="{StaticResource PageTitle}"
                                   Margin="0,2,0,0" />
                        <TextBlock x:Name="PageSubtitleText" Text="{loc:Loc Key=PageInstallSubtitle}"
                                   Style="{StaticResource PageSubtitle}" Margin="0,3,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="24" Padding="7,5,13,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="42" Height="30">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        HorizontalAlignment="Left" />
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="2"
                                        HorizontalAlignment="Right" />
                                <Path Style="{StaticResource SteamGlyphStyle}" Width="14" Height="14"
                                      HorizontalAlignment="Left" Margin="7,0,0,0" />
                                <Path Style="{StaticResource SteamGlyphStyle}" Width="14" Height="14"
                                      Fill="{DynamicResource InkBrush}" HorizontalAlignment="Right" Margin="0,0,7,0" />
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PairStatusTitle}" FontFamily="{StaticResource BodyFont}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="{Binding PairStatusDetail}" FontFamily="{StaticResource BodyFont}"
                                           FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <ContentControl x:Name="ViewHost" Grid.Row="1" Margin="0,4,0,8"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                RenderTransformOrigin="0.5,0">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ViewTranslate" Y="0" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>

        <Border x:Name="DockBorder" Grid.Row="2" Background="{DynamicResource DockBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,10,28,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterStatusText" Text="{loc:Loc Key=NoChanges}"
                                   Style="{StaticResource CaptionText}" Margin="9,0,0,0"
                                   MaxWidth="560" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Content="{loc:Loc Key=ActionBack}"
                                Padding="13,0" Click="BackButton_Click" />
                        <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" Content="{loc:Loc Key=ActionContinue}"
                                Padding="16,0" Margin="6,0,0,0" Click="ContinueButton_Click"
                                AutomationProperties.AutomationId="PrimaryActionButton" />
                    </StackPanel>
                </Grid>

                <controls:JourneyBar x:Name="Journey" Grid.Row="1" Margin="0,4,0,0"
                                     StepSelected="Journey_StepSelected" />
            </Grid>
        </Border>

        <ContentControl x:Name="WelcomeHost"
                        Grid.Row="1" Grid.RowSpan="2"
                        Panel.ZIndex="10"
                        Visibility="Collapsed"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <ContentControl x:Name="InstallHost"
                        Grid.Row="1" Grid.RowSpan="2"
                        Panel.ZIndex="11"
                        Visibility="Collapsed"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <Grid x:Name="OptionsHost"
              Grid.Row="1" Grid.RowSpan="2"
              Panel.ZIndex="12"
              Visibility="Collapsed"
              Background="{DynamicResource WindowBackgroundBrush}">
            <Grid Margin="34,22,34,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,24,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=StepOptions}" Style="{StaticResource KickerText}" />
                        <TextBlock Text="{loc:Loc Key=StepOptions}" Style="{StaticResource PageTitle}" Margin="0,2,0,0" />
                        <TextBlock Text="{loc:Loc Key=PageOptionsSubtitle}" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="OptionsCloseButton" Style="{StaticResource WindowButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="OptionsCloseButton_Click"
                            ToolTip="{loc:Loc Key=ActionClose}"
                            AutomationProperties.Name="{loc:Loc Key=ActionClose}"
                            AutomationProperties.AutomationId="OptionsCloseButton">
                        <TextBlock Text="×" FontSize="14" />
                    </Button>
                </Grid>

                <ContentControl x:Name="OptionsContent" Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</Window>

